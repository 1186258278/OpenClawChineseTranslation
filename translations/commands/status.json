{
  "file": "src/commands/status.command-report.ts",
  "description": "状态命令 - 报告各区块标题",
  "replacements": {
    "appendStatusReportLines(report, \"Channels\", [channelsMessage]);": "appendStatusReportLines(report, \"通道\", [channelsMessage]);",
    "appendStatusReportLines(report, \"Sessions\", [sessionsMessage]);": "appendStatusReportLines(report, \"会话\", [sessionsMessage]);",
    "\"System events\",": "\"系统事件\",",
    "appendStatusReportTable(report, \"Overview\", [...statusOverviewTableColumns], params.overviewRows);": "appendStatusReportTable(report, \"概览\", overviewColumns, overviewRows);",
    "appendStatusReportTable(report, \"Health\", [...(params.healthColumns ?? [])], params.healthRows);": "appendStatusReportTable(report, \"健康状态\", healthColumns, healthRows);",
    "appendStatusReportLines(report, \"Usage\", params.usageLines);": "appendStatusReportLines(report, \"用量统计\", usageLines);",
    "appendStatusReportTable(report, \"Channels\", [...params.channelsColumns], params.channelsRows);": "appendStatusReportTable(report, \"通道\", channelsColumns, channelsRows);",
    "appendStatusReportTable(report, \"Sessions\", [...params.sessionsColumns], params.sessionsRows);": "appendStatusReportTable(report, \"会话\", sessionsColumns, sessionsRows);",
    "theme.muted(\"No channels configured\")": "params.muted(\"尚未配置渠道\")",
    "theme.muted(\"No sessions\")": "params.muted(\"暂无会话\")",
    "appendStatusReportLines(report, \"Plugin compatibility\", params.pluginCompatibilityLines);": "appendStatusReportLines(report, \"插件兼容性\", pluginCompatibilityLines);",
    "appendStatusReportLines(report, \"Model selection\", params.modelSelectionLines);": "appendStatusReportLines(report, \"模型选择\", modelSelectionLines);",
    "[{ key: \"Event\", header: \"Event\", flex: true, minWidth: 24 }]": "[{ key: \"Event\", header: \"事件\", flex: true, minWidth: 24 }]"
  }
}
